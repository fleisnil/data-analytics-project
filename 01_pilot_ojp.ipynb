import requests
import pandas as pd
import xml.etree.ElementTree as ET

from datetime import datetime, timezone
from getpass import getpass
from uuid import uuid4
from pathlib import Path


# ============================================================
# 1. API CONFIGURATION
# ============================================================

TOKEN = getpass("OJP API Token: ").strip()

if not TOKEN:
    raise ValueError(
        "Der OJP API Token ist leer. Bitte gültigen Token eingeben."
    )

URL = "https://api.opentransportdata.swiss/ojp20"

# Pilot station: Zürich HB
STOP_ID = "ch:1:sloid:3000"
STOP_NAME = "Zürich HB"


# ============================================================
# 2. TIMESTAMP / MESSAGE ID
# ============================================================

now_utc = datetime.now(timezone.utc)

timestamp = (
    now_utc
    .isoformat(timespec="milliseconds")
    .replace("+00:00", "Z")
)

message_id = f"zhaw-pilot-{uuid4()}"


# ============================================================
# 3. BUILD OJP XML REQUEST
# ============================================================

xml_request = f"""
<OJP
    xmlns="http://www.vdv.de/ojp"
    xmlns:siri="http://www.siri.org.uk/siri"
    version="2.0">

    <OJPRequest>
        <siri:ServiceRequest>

            <siri:ServiceRequestContext>
                <siri:Language>de</siri:Language>
            </siri:ServiceRequestContext>

            <siri:RequestTimestamp>
                {timestamp}
            </siri:RequestTimestamp>

            <siri:RequestorRef>
                ZHAW_DataAnalytics_Project
            </siri:RequestorRef>

            <OJPStopEventRequest>

                <siri:RequestTimestamp>
                    {timestamp}
                </siri:RequestTimestamp>

                <siri:MessageIdentifier>
                    {message_id}
                </siri:MessageIdentifier>

                <Location>

                    <PlaceRef>

                        <StopPlaceRef>
                            {STOP_ID}
                        </StopPlaceRef>

                        <Name>
                            <Text>{STOP_NAME}</Text>
                        </Name>

                    </PlaceRef>

                    <DepArrTime>
                        {timestamp}
                    </DepArrTime>

                </Location>

                <Params>

                    <NumberOfResults>
                        20
                    </NumberOfResults>

                    <StopEventType>
                        departure
                    </StopEventType>

                    <IncludePreviousCalls>
                        false
                    </IncludePreviousCalls>

                    <IncludeOnwardCalls>
                        false
                    </IncludeOnwardCalls>

                    <UseRealtimeData>
                        full
                    </UseRealtimeData>

                </Params>

            </OJPStopEventRequest>

        </siri:ServiceRequest>
    </OJPRequest>

</OJP>
"""


# ============================================================
# 4. SEND API REQUEST
# ============================================================

headers = {
    "Content-Type": "application/xml",
    "Authorization": "Bearer " + TOKEN
}

response = requests.post(
    URL,
    headers=headers,
    data=xml_request.encode("utf-8"),
    timeout=30
)

print("HTTP Status:", response.status_code)
print("Response length:", len(response.text))


# ============================================================
# 5. CHECK HTTP RESPONSE
# ============================================================

try:
    response.raise_for_status()

except requests.HTTPError as exc:

    print("\nHTTP-Fehler Response-Ausschnitt:")
    print(response.text[:500])

    raise RuntimeError(
        f"OJP API Request fehlgeschlagen "
        f"({response.status_code})."
    ) from exc


# ============================================================
# 6. SAVE RAW XML RESPONSE
# ============================================================

raw_dir = Path("data/raw/ojp")

raw_dir.mkdir(
    parents=True,
    exist_ok=True
)

safe_station_name = (
    STOP_NAME
    .lower()
    .replace(" ", "_")
    .replace("ü", "ue")
    .replace("ö", "oe")
    .replace("ä", "ae")
)

raw_filename = (
    raw_dir
    / f"{safe_station_name}_"
      f"{now_utc.strftime('%Y%m%d_%H%M%S')}.xml"
)

raw_filename.write_bytes(response.content)

print("Raw XML gespeichert unter:")
print(raw_filename)


# ============================================================
# 7. PARSE XML
# ============================================================

try:

    root = ET.fromstring(
        response.content
    )

except ET.ParseError as exc:

    print("\nUngültige XML-Antwort (Ausschnitt):")
    print(response.text[:500])

    raise RuntimeError(
        "OJP API lieferte kein gültiges XML."
    ) from exc


# XML namespaces
ns = {
    "ojp": "http://www.vdv.de/ojp",
    "siri": "http://www.siri.org.uk/siri"
}

results = root.findall(
    ".//ojp:StopEventResult",
    ns
)

print(
    "Gefundene Verbindungen:",
    len(results)
)


# ============================================================
# 8. HELPER FUNCTION FOR BOOLEAN VALUES
# ============================================================

def parse_bool(value):

    if value is None:
        return pd.NA

    value = str(value).strip().lower()

    if value == "true":
        return True

    if value == "false":
        return False

    return pd.NA


# ============================================================
# 9. EXTRACT DATA FROM XML
# ============================================================

rows = []

for result in results:

    stop_event = result.find(
        "ojp:StopEvent",
        ns
    )

    if stop_event is None:
        continue


    # --------------------------------------------------------
    # Service / journey information
    # --------------------------------------------------------

    service = stop_event.find(
        "ojp:Service",
        ns
    )

    if service is None:
        continue


    journey_ref = service.findtext(
        "ojp:JourneyRef",
        default=None,
        namespaces=ns
    )

    operating_day = service.findtext(
        "ojp:OperatingDayRef",
        default=None,
        namespaces=ns
    )

    pt_mode = service.findtext(
        "ojp:Mode/ojp:PtMode",
        default=None,
        namespaces=ns
    )

    line = service.findtext(
        "ojp:PublishedServiceName/ojp:Text",
        default=None,
        namespaces=ns
    )

    origin = service.findtext(
        "ojp:OriginText/ojp:Text",
        default=None,
        namespaces=ns
    )

    destination = service.findtext(
        "ojp:DestinationText/ojp:Text",
        default=None,
        namespaces=ns
    )

    cancelled_text = service.findtext(
        "ojp:Cancelled",
        default=None,
        namespaces=ns
    )


    # --------------------------------------------------------
    # Current stop information
    # --------------------------------------------------------

    this_call = stop_event.find(
        "ojp:ThisCall/ojp:CallAtStop",
        ns
    )

    if this_call is None:
        continue


    scheduled_departure = this_call.findtext(
        "ojp:ServiceDeparture/ojp:TimetabledTime",
        default=None,
        namespaces=ns
    )

    estimated_departure = this_call.findtext(
        "ojp:ServiceDeparture/ojp:EstimatedTime",
        default=None,
        namespaces=ns
    )

    platform_planned = this_call.findtext(
        "ojp:PlannedQuay/ojp:Text",
        default=None,
        namespaces=ns
    )

    platform_estimated = this_call.findtext(
        "ojp:EstimatedQuay/ojp:Text",
        default=None,
        namespaces=ns
    )


    # --------------------------------------------------------
    # Add observation
    # --------------------------------------------------------

    rows.append({
        "collection_timestamp": timestamp,
        "station_id": STOP_ID,
        "station_name": STOP_NAME,
        "journey_ref": journey_ref,
        "operating_day": operating_day,
        "transport_mode": pt_mode,
        "line": line,
        "origin": origin,
        "destination": destination,
        "scheduled_departure": scheduled_departure,
        "estimated_departure": estimated_departure,
        "planned_platform": platform_planned,
        "estimated_platform": platform_estimated,
        "cancelled": parse_bool(cancelled_text)
    })


# ============================================================
# 10. CREATE DATAFRAME
# ============================================================

schema_columns = [
    "collection_timestamp",
    "station_id",
    "station_name",
    "journey_ref",
    "operating_day",
    "transport_mode",
    "line",
    "origin",
    "destination",
    "scheduled_departure",
    "estimated_departure",
    "planned_platform",
    "estimated_platform",
    "cancelled"
]

df = pd.DataFrame(
    rows,
    columns=schema_columns
)

print("\nDataFrame shape:")
print(df.shape)


# ============================================================
# 11. CONVERT TIME VARIABLES
# ============================================================

df["scheduled_departure"] = pd.to_datetime(
    df["scheduled_departure"],
    utc=True,
    errors="coerce"
)

df["estimated_departure"] = pd.to_datetime(
    df["estimated_departure"],
    utc=True,
    errors="coerce"
)

df["collection_timestamp"] = pd.to_datetime(
    df["collection_timestamp"],
    utc=True,
    errors="coerce"
)


# ============================================================
# 12. REALTIME INFORMATION
# ============================================================

# True if EstimatedTime exists
df["has_realtime"] = (
    df["estimated_departure"]
    .notna()
)


# IMPORTANT:
# Missing EstimatedTime must NOT be interpreted as zero delay.

df["predicted_delay_minutes"] = (
    df["estimated_departure"]
    - df["scheduled_departure"]
).dt.total_seconds() / 60


# Optional field only for display:
# If no realtime value exists, use scheduled time.
# Do NOT use this variable for delay calculation.

df["effective_departure"] = (
    df["estimated_departure"]
    .combine_first(
        df["scheduled_departure"]
    )
)


# ============================================================
# 13. CONVERT CANCELLED TO NULLABLE BOOLEAN
# ============================================================

df["cancelled"] = (
    df["cancelled"]
    .astype("boolean")
)


# ============================================================
# 14. SWISS LOCAL TIME
# ============================================================

df["scheduled_departure_local"] = (
    df["scheduled_departure"]
    .dt.tz_convert("Europe/Zurich")
)

df["estimated_departure_local"] = (
    df["estimated_departure"]
    .dt.tz_convert("Europe/Zurich")
)

df["collection_timestamp_local"] = (
    df["collection_timestamp"]
    .dt.tz_convert("Europe/Zurich")
)


# ============================================================
# 15. CREATE TEMPORAL VARIABLES
# ============================================================

df["date"] = (
    df["scheduled_departure_local"]
    .dt.date
)

df["hour"] = (
    df["scheduled_departure_local"]
    .dt.hour
)

df["weekday"] = (
    df["scheduled_departure_local"]
    .dt.day_name()
)

df["weekend"] = (
    df["scheduled_departure_local"]
    .dt.dayofweek >= 5
)


# ============================================================
# 16. MINUTES UNTIL DEPARTURE
# ============================================================

df["minutes_until_departure"] = (
    df["scheduled_departure"]
    - df["collection_timestamp"]
).dt.total_seconds() / 60


# ============================================================
# 17. OPTIONAL DELAY CLASSIFICATION
# ============================================================

# For now this is only an experimental definition.
# The final threshold should be justified later.

df["is_delayed_5min"] = pd.NA

realtime_mask = (
    df["predicted_delay_minutes"]
    .notna()
)

df.loc[
    realtime_mask,
    "is_delayed_5min"
] = (
    df.loc[
        realtime_mask,
        "predicted_delay_minutes"
    ] >= 5
)

df["is_delayed_5min"] = (
    df["is_delayed_5min"]
    .astype("boolean")
)


# ============================================================
# 18. BASIC DATA QUALITY CHECK
# ============================================================

print("\nMissing values:")
print(
    df.isna().sum()
)

print("\nTransport modes:")
print(
    df["transport_mode"]
    .value_counts(
        dropna=False
    )
)

print("\nRealtime availability:")
print(
    df["has_realtime"]
    .value_counts(
        dropna=False
    )
)

print("\nDelay summary:")
print(
    df["predicted_delay_minutes"]
    .describe()
)


# ============================================================
# 19. DISPLAY PILOT RESULTS
# ============================================================

display_columns = [
    "station_name",
    "transport_mode",
    "line",
    "destination",
    "scheduled_departure_local",
    "estimated_departure_local",
    "predicted_delay_minutes",
    "minutes_until_departure",
    "has_realtime",
    "planned_platform",
    "estimated_platform",
    "cancelled"
]

display(
    df[display_columns]
    .head(20)
)


# ============================================================
# 20. SHOW MOST DELAYED CONNECTIONS
# ============================================================

print("\nMost delayed connections:")

display(
    df[
        [
            "line",
            "destination",
            "scheduled_departure_local",
            "estimated_departure_local",
            "predicted_delay_minutes",
            "minutes_until_departure"
        ]
    ]
    .sort_values(
        "predicted_delay_minutes",
        ascending=False
    )
    .head(10)
)


# ============================================================
# 21. SAVE PARSED PILOT DATA
# ============================================================

processed_dir = Path(
    "data/interim"
)

processed_dir.mkdir(
    parents=True,
    exist_ok=True
)

csv_filename = (
    processed_dir
    / f"{safe_station_name}_"
      f"{now_utc.strftime('%Y%m%d_%H%M%S')}.csv"
)

df.to_csv(
    csv_filename,
    index=False
)

print("\nParsed CSV gespeichert unter:")
print(csv_filename)


# ============================================================
# 22. FINAL PILOT SUMMARY
# ============================================================

print("\n-----------------------------")
print("PILOT SUMMARY")
print("-----------------------------")

print(
    "Total observations:",
    len(df)
)

print(
    "Observations with realtime data:",
    df["has_realtime"].sum()
)

print(
    "Observations without realtime data:",
    (~df["has_realtime"]).sum()
)

print(
    "Mean predicted delay:",
    round(
        df["predicted_delay_minutes"].mean(),
        2
    )
)

print(
    "Median predicted delay:",
    round(
        df["predicted_delay_minutes"].median(),
        2
    )
)

print("-----------------------------")
