import requests
import pandas as pd
import xml.etree.ElementTree as ET

from datetime import datetime, timezone
from getpass import getpass
from uuid import uuid4


TOKEN = getpass("OJP API Token: ")

URL = "https://api.opentransportdata.swiss/ojp20"

# Zürich HB
STOP_ID = "ch:1:sloid:3000"
STOP_NAME = "Zürich HB"

# Aktuelle Zeit in UTC / Zulu-Time
now_utc = datetime.now(timezone.utc)
timestamp = now_utc.isoformat(timespec="milliseconds").replace("+00:00", "Z")

message_id = f"zhaw-pilot-{uuid4()}"

xml_request = f"""
<OJP
    xmlns="http://www.vdv.de/ojp"
    xmlns:siri="http://www.siri.org.uk/siri"
    version="2.0">

    <OJPRequest>
        <siri:ServiceRequest>

            <siri:ServiceRequestContext>
                <siri:Language>de</siri:Language>
            </siri:ServiceRequestContext>

            <siri:RequestTimestamp>{timestamp}</siri:RequestTimestamp>

            <siri:RequestorRef>
                ZHAW_DataAnalytics_Project
            </siri:RequestorRef>

            <OJPStopEventRequest>

                <siri:RequestTimestamp>
                    {timestamp}
                </siri:RequestTimestamp>

                <siri:MessageIdentifier>
                    {message_id}
                </siri:MessageIdentifier>

                <Location>

                    <PlaceRef>

                        <StopPlaceRef>
                            {STOP_ID}
                        </StopPlaceRef>

                        <Name>
                            <Text>{STOP_NAME}</Text>
                        </Name>

                    </PlaceRef>

                    <DepArrTime>
                        {timestamp}
                    </DepArrTime>

                </Location>

                <Params>

                    <NumberOfResults>
                        20
                    </NumberOfResults>

                    <StopEventType>
                        departure
                    </StopEventType>

                    <IncludePreviousCalls>
                        false
                    </IncludePreviousCalls>

                    <IncludeOnwardCalls>
                        false
                    </IncludeOnwardCalls>

                    <UseRealtimeData>
                        full
                    </UseRealtimeData>

                </Params>

            </OJPStopEventRequest>

        </siri:ServiceRequest>
    </OJPRequest>

</OJP>
"""

print(xml_request[:1000])



headers = {
    "Content-Type": "application/xml",
    "Authorization": f"Bearer {TOKEN}"
}

response = requests.post(
    URL,
    headers=headers,
    data=xml_request.encode("utf-8"),
    timeout=30
)

print("HTTP Status:", response.status_code)
print("Response length:", len(response.text))


root = ET.fromstring(response.content)

ns = {
    "ojp": "http://www.vdv.de/ojp",
    "siri": "http://www.siri.org.uk/siri"
}

results = root.findall(".//ojp:StopEventResult", ns)

print("Gefundene Verbindungen:", len(results))



rows = []

for result in results:

    stop_event = result.find("ojp:StopEvent", ns)

    if stop_event is None:
        continue

    # --------------------------
    # Fahrt / Service
    # --------------------------

    service = stop_event.find("ojp:Service", ns)

    if service is None:
        continue

    journey_ref = service.findtext(
        "ojp:JourneyRef",
        default=None,
        namespaces=ns
    )

    operating_day = service.findtext(
        "ojp:OperatingDayRef",
        default=None,
        namespaces=ns
    )

    pt_mode = service.findtext(
        "ojp:Mode/ojp:PtMode",
        default=None,
        namespaces=ns
    )

    line = service.findtext(
        "ojp:PublishedServiceName/ojp:Text",
        default=None,
        namespaces=ns
    )

    origin = service.findtext(
        "ojp:OriginText/ojp:Text",
        default=None,
        namespaces=ns
    )

    destination = service.findtext(
        "ojp:DestinationText/ojp:Text",
        default=None,
        namespaces=ns
    )

    cancelled_text = service.findtext(
        "ojp:Cancelled",
        default="false",
        namespaces=ns
    )

    # --------------------------
    # Halt Zürich HB
    # --------------------------

    this_call = stop_event.find(
        "ojp:ThisCall/ojp:CallAtStop",
        ns
    )

    if this_call is None:
        continue

    scheduled_departure = this_call.findtext(
        "ojp:ServiceDeparture/ojp:TimetabledTime",
        default=None,
        namespaces=ns
    )

    estimated_departure = this_call.findtext(
        "ojp:ServiceDeparture/ojp:EstimatedTime",
        default=None,
        namespaces=ns
    )

    platform_planned = this_call.findtext(
        "ojp:PlannedQuay/ojp:Text",
        default=None,
        namespaces=ns
    )

    platform_estimated = this_call.findtext(
        "ojp:EstimatedQuay/ojp:Text",
        default=None,
        namespaces=ns
    )

    rows.append({
        "collection_timestamp": timestamp,
        "station_id": STOP_ID,
        "station_name": STOP_NAME,
        "journey_ref": journey_ref,
        "operating_day": operating_day,
        "transport_mode": pt_mode,
        "line": line,
        "origin": origin,
        "destination": destination,
        "scheduled_departure": scheduled_departure,
        "estimated_departure": estimated_departure,
        "planned_platform": platform_planned,
        "estimated_platform": platform_estimated,
        "cancelled": cancelled_text.lower() == "true"
    })

df = pd.DataFrame(rows)

df.head()


df["scheduled_departure"] = pd.to_datetime(
    df["scheduled_departure"],
    utc=True
)

df["estimated_departure"] = pd.to_datetime(
    df["estimated_departure"],
    utc=True
)

df["collection_timestamp"] = pd.to_datetime(
    df["collection_timestamp"],
    utc=True
)

df["predicted_delay_minutes"] = (
    df["estimated_departure"]
    - df["scheduled_departure"]
).dt.total_seconds() / 60


df[
    [
        "station_name",
        "transport_mode",
        "line",
        "destination",
        "scheduled_departure",
        "estimated_departure",
        "predicted_delay_minutes"
    ]
]
