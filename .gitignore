# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Secrets / local configuration
.env
.env.*
!.env.example

# Generated OJP and MeteoSwiss collection data
data/raw/ojp/
data/raw/weather/
data/interim/ojp_snapshots/
data/interim/weather_snapshots/

