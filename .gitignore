data/processed/*.csv
data/processed/*.parquet

# Generated analysis outputs
results/figures/*
results/tables/*
results/model/*

# Keep directory placeholders
!results/figures/.gitkeep
!results/tables/.gitkeep
!results/model/.gitkeep
!data/processed/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
